{
  "name": "pi-investment",
  "version": "0.1.0",
  "type": "module",
  "description": "AI 股票投资顾问 - 基于 piagent 架构",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' tsx src/index.ts",
    "dev:log": "NODE_OPTIONS='--max-old-space-size=8192' tsx src/index-with-logger.ts",
    "feishu": "NODE_OPTIONS='--max-old-space-size=8192' tsx src/api/feishu.ts",
    "wake": "NODE_OPTIONS='--max-old-space-size=8192' tsx src/api/start-wake-channel.ts",
    "dashboard": "bash start-dashboard.sh",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/agent-cli.ts",
    "portfolio": "tsx src/scripts/portfolio-cli.ts",
    "migrate:hk-holdings": "tsx src/scripts/migrate-hk-holdings.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:quant-web": "npm --prefix quant-web test",
    "test:notification": "tsx src/scripts/test-notification.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.38.0",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@mariozechner/pi-tui": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "openai": "^4.77.0",
    "pg": "^8.22.0",
    "playwright": "^1.58.2",
    "proper-lockfile": "^4.1.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.6"
  }
}
