# === LLM Provider 配置 ===
# 选择模型提供方：deepseek（默认）或 kimi
LLM_PROVIDER=deepseek

# --- DeepSeek（LLM_PROVIDER=deepseek 时生效） ---
# 官方模型：deepseek-v4-flash（默认，便宜）/ deepseek-v4-pro（更强，约3倍价）
# 两者均为 1M 上下文 / 384K 最大输出
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_ID=deepseek-v4-flash
# DEEPSEEK_MODEL_ID=deepseek-v4-pro   # 切 pro 用这行（优先级高于 MODEL_ID，重启生效）

# --- Kimi / Moonshot（LLM_PROVIDER=kimi 时生效） ---
# 注册地址: https://platform.moonshot.cn
# KIMI_API_KEY=sk-你的key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# MODEL_ID=kimi-k3    # 可覆盖为具体版本，如 kimi-k3-xxxx-preview

# --- 通用覆盖（可选，对任意 provider 生效） ---
# LLM_API_KEY=            # 覆盖上述任意 key
# LLM_BASE_URL=           # 覆盖上述任意 baseUrl
# LLM_REASONING=false     # 关闭 reasoning 解析（非思考模型时设置）
# LLM_CONTEXT_WINDOW=     # 覆盖上下文窗口大小
# LLM_MAX_TOKENS=         # 覆盖最大输出 token 数

# SDK 内部通过 OPENAI_API_KEY 读取（必须设置，与当前 provider 的 key 一致）
OPENAI_API_KEY=sk-你的key

# Feishu Bot（可选，启用飞书集成时必填）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
# 可选：Webhook URL（用于 feishu_notify 工具发送通知）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 可选：Chat ID（用于指定发送目标群聊）
FEISHU_CHAT_ID=oc_xxx

# Tavily Search API (可选，用于网络搜索补充实时信息)
# 注册地址: https://tavily.com
TAVILY_API_KEY=tvly-你的key

# === 固定 IP 配置（主分支不允许修改以下值） ===
# QuantSys V2 后端 API
QUANTSYS_V2_API_URL=http://127.0.0.1:5001

# quant-v2-client 瞬时故障重试（默认开：最多 2 次重试，退避 500ms→1500ms；
# HTTP 502/503/504 任意方法重试；网络错误/超时仅 GET 重试——非幂等 POST 防重复执行；
# 4xx 与业务错误不重试）
# QUANT_CLIENT_RETRY=0          # 设为 0 关闭重试
# QUANT_CLIENT_RETRY_MAX=2      # 最大重试次数
# QUANT_CLIENT_RETRY_DELAY_MS=500  # 退避基数（ms）

# 进化执行器自动执行开关（2026-08-05 起默认关：建议转人工任务，不丢失；
# 仅设为 1/true 才自动应用 update_experience/add_tool/update_code 等改动）
# EVOLUTION_AUTO_EXECUTE=0

# PostgreSQL 配置（仅用于 Python 后端 quantsys-v2）
# TypeScript Agent 不再直接连接数据库
PGDATABASE=quant_investment

# Quant database (PostgreSQL only)
QUANT_DB_PROVIDER=postgres
# 可选：使用完整连接串覆盖 PGDATABASE/PGHOST/PGPORT/PGUSER/PGPASSWORD
# QUANT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/quant_investment

# Claude Code CLI Configuration
CLAUDE_CODE_CLI_PATH=claude-code    # CLI command path
CLAUDE_CODE_TIMEOUT=120000          # Default timeout (ms)
CLAUDE_CODE_ENABLED=true            # Enable/disable integration

# Agent Gateway / Wake Channel
WAKE_CHANNEL_PORT=3002
WAKE_TOKEN=          # 配置后 /wake 强制鉴权；留空则放行（仅开发）
