# Test Database Configuration
# This file is used by pytest to configure the test database connection

# Option 1: Use full DATABASE_URL (recommended)
# NOTE: .env (production) sets QUANT_DATABASE_URL which takes priority over PG*
# vars in _resolve_db_dsn(). We must set the DSN vars here so the app's
# load_dotenv(override=False) cannot override them back to production.
QUANT_DATABASE_URL=postgresql://mac@127.0.0.1:5432/quant_test
DATABASE_URL=postgresql://mac@127.0.0.1:5432/quant_test

# Option 2: Use individual PostgreSQL environment variables
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=quant_test
PGUSER=mac
PGPASSWORD=

# Test-specific settings
PYTHONDONTWRITEBYTECODE=1
