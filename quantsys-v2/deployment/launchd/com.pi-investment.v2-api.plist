<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.pi-investment.v2-api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mac/Documents/ai/pi-investment/quantsys-v2/venv/bin/python</string>
        <string>-u</string>
        <string>/Users/mac/Documents/ai/pi-investment/quantsys-v2/adapters/inbound/fastapi_app/main.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/mac/Documents/ai/pi-investment/quantsys-v2</string>
    <!-- QuantSys V2 API 守护（2026-10-02 立，REQ-261001145152-3982 · 用户裁定"装 launchd"）。
         动因：本服务已静默死亡 3 次（08-02 盯盘消失一周 / 08-05 调度死讯静默 8 天 /
         2026-10-01 实测停摆 18 天），共同点都是**没有守护进程**——手工 nohup 起的服务
         一旦退出无人拉起，而监控原先跑在被监控进程里，进程一死监控同死。
         本作业把拉起权交给 launchd：KeepAlive 保证崩溃即拉起，RunAtLoad 保证登录即起。
         配套：deployment/launchd/com.pi-investment.health-probe.plist 独立探活（与进程无关）。
         ✅ 调度归属（2026-10-02 用户裁定 + t-2d52a7 落地）：业务的定时任务归 **v2 自己调度**——
         本 plist **不再设任何 DISABLE_** 开关，故 ② APSchedulerService（读 quant.scheduler_tasks，
         已去重到 16 条 / 无撞点）与 ③ DailyJobs 宿主（9 个核心数据任务）均按各自排班运行；
         Agent OS 只负责 agent 自身任务（AGENT_OS_ENABLED=false，通知开关不受影响）。
         ⚠️ 自 2026-10-02 起 main.py 的路径引导已上移到文件顶部，故**不需要 PYTHONPATH**
         （此前文档里的启动命令照抄会失败，已修）。 -->
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key><string>/Users/mac/Documents/ai/pi-investment/quantsys-v2/logs/launchd-api.log</string>
    <key>StandardErrorPath</key><string>/Users/mac/Documents/ai/pi-investment/quantsys-v2/logs/launchd-api.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>Asia/Shanghai</string>
        <key>LOG_FILE</key><string>logs/api.log</string>
    </dict>
</dict>
</plist>
