[Unit]
Description=QuantSys V13 Scheduler Service
After=network.target postgresql.service

[Service]
Type=simple
User=mac
WorkingDirectory=/Users/mac/Documents/ai/pi-investment/quantsys-v2
ExecStart=/usr/local/bin/python3 /Users/mac/Documents/ai/pi-investment/quantsys-v2/scheduler_daemon.py
Restart=always
RestartSec=10
StandardOutput=append:/Users/mac/Documents/ai/pi-investment/quantsys-v2/logs/scheduler_daemon.log
StandardError=append:/Users/mac/Documents/ai/pi-investment/quantsys-v2/logs/scheduler_daemon_error.log
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
