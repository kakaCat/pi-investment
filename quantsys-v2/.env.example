# 环境配置示例
# 复制此文件为 .env 并根据实际情况修改

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
#
# Database Separation:
# - Production database: Used by API server, CLI tools, and scripts
# - Test database: Automatically used when running pytest tests
#
# The system automatically switches to the test database when pytest is detected.
# Test database names MUST end with '_test' suffix for safety.
#
# To create the test database:
#   CREATE DATABASE quant_test;
#   GRANT ALL PRIVILEGES ON DATABASE quant_test TO your_user;
# ============================================================================

# Production Database (default)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=quant_investment
PGUSER=your_username
PGPASSWORD=your_password

# Test Database (used automatically by pytest)
# Create a separate .env.test file with:
#   PGDATABASE=quant_test
# The test database will be used automatically when running pytest.

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis连接配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis超时配置（秒）
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# 是否启用Redis缓存（true/false）
USE_REDIS_CACHE=true

# ============================================================================
# PORTFOLIO CONFIGURATION
# ============================================================================

# Portfolio Configuration
INITIAL_CASH=1000000.0
