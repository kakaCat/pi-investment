#!/bin/bash
# Pre-commit hook: 强制日志规范检查
# 安装方法: cp pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Pre-commit 检查..."

# 获取即将提交的 Python 文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ 没有 Python 文件变更"
    exit 0
fi

HAS_ERROR=0

# ========================================
# 检查 1: 禁止使用 logging.basicConfig
# ========================================
echo "📋 检查 1: 禁止 logging.basicConfig..."
for FILE in $STAGED_FILES; do
    if git diff --cached "$FILE" | grep -E '^\+.*logging\.basicConfig'; then
        echo "❌ 错误: $FILE 使用了 logging.basicConfig"
        echo "   请使用: from infrastructure.logging import configure_structured_logging"
        HAS_ERROR=1
    fi
done

# ========================================
# 检查 2: 新文件应使用 structlog
# ========================================
echo "📋 检查 2: 新文件应使用 structlog..."
for FILE in $STAGED_FILES; do
    # 跳过测试文件和工具脚本
    if [[ "$FILE" == *"test_"* ]] || [[ "$FILE" == *"/tests/"* ]] || [[ "$FILE" == *"/scripts/"* ]]; then
        continue
    fi

    # 检查是否是新增文件
    if ! git cat-file -e "HEAD:$FILE" 2>/dev/null; then
        # 新文件：检查是否使用了 logging.getLogger
        if git diff --cached "$FILE" | grep -E '^\+.*logging\.getLogger'; then
            echo "⚠️  警告: $FILE 是新文件但使用了 logging.getLogger"
            echo "   推荐使用: import structlog; logger = structlog.get_logger(__name__)"
            echo "   如果必须使用 logging，请在 commit message 中说明原因"
            # 这是警告，不阻止提交
        fi
    fi
done

# ========================================
# 检查 3: 禁止直接使用 print() (业务代码)
# ========================================
echo "📋 检查 3: 检查 print() 使用..."
for FILE in $STAGED_FILES; do
    # 跳过 CLI 工具和脚本
    if [[ "$FILE" == *"/cli/"* ]] || [[ "$FILE" == *"cli.py"* ]] || [[ "$FILE" == *"/scripts/"* ]]; then
        continue
    fi

    # 检查业务代码中的 print()
    if git diff --cached "$FILE" | grep -E '^\+.*[^#].*print\('; then
        echo "⚠️  警告: $FILE 使用了 print()"
        echo "   业务代码应使用: logger.info() / logger.debug()"
        echo "   CLI 工具除外"
        # 这是警告，不阻止提交
    fi
done

# ========================================
# 检查 4: Python 版本兼容性（类型提示）
# ========================================
echo "📋 检查 4: Python 3.12+ 语法..."
for FILE in $STAGED_FILES; do
    # 检查是否使用了旧式类型联合（Python 3.8 不支持）
    if git diff --cached "$FILE" | grep -E '^\+.*(Dict|List|Tuple|Set)\s*\|'; then
        echo "✅ $FILE 使用了现代类型联合语法 (Dict | List)"
        echo "   确保项目要求 Python 3.12+"
    fi
done

# ========================================
# 检查 5: 结构化日志格式
# ========================================
echo "📋 检查 5: 结构化日志格式..."
for FILE in $STAGED_FILES; do
    # 检查是否混用了字符串格式化和结构化日志
    if git diff --cached "$FILE" | grep -E '^\+.*logger\.(info|debug|warning|error).*%.*\)'; then
        echo "⚠️  提示: $FILE 可能使用了字符串格式化"
        echo "   推荐: logger.info('message', key=value) 而非 logger.info('message %s', value)"
    fi
done

# ========================================
# 最终结果
# ========================================
echo ""
if [ $HAS_ERROR -eq 1 ]; then
    echo "=" * 60
    echo "❌ Pre-commit 检查失败"
    echo "=" * 60
    echo "请修复上述错误后重新提交"
    echo ""
    echo "如需跳过检查 (不推荐):"
    echo "  git commit --no-verify"
    echo "=" * 60
    exit 1
else
    echo "✅ Pre-commit 检查通过"
    exit 0
fi
