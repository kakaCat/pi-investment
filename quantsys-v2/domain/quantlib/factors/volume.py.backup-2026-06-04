"""
Volume Indicators Module
=========================

Volume-based technical factors including OBV, MFI, VWAP, and volume moving averages.
Migrated from technical_factors.py to BaseCalculator framework.
"""

import numpy as np
from typing import Dict, Any, List

from quantlib.factors.base import TechnicalFactorCalculator
from quantlib.core.base_calculator import validate_inputs, timing_decorator
from quantlib.core.exceptions import InsufficientDataError


class VolumeFactors(TechnicalFactorCalculator):
    """
    Volume indicator calculator.

    Provides OBV, MFI, VWAP, and volume-related calculations.
    """

    def get_supported_methods(self) -> List[str]:
        """Return list of supported volume indicators."""
        return [
            'obv', 'mfi14', 'vwap',
            'volume_ma5', 'volume_ma10',
            'volume_ratio', 'turnover_rate'
        ]

    # =========================================================================
    # OBV (On Balance Volume)
    # =========================================================================

    @validate_inputs
    @timing_decorator
    def obv(self, klines: List[Dict[str, Any]]) -> Dict[str, Any]:
        """
        Calculate On Balance Volume.

        OBV = cumulative sum of volume * sign(price change)
        - If close > prev_close: add volume
        - If close < prev_close: subtract volume
        - If close == prev_close: no change

        Args:
            klines: K-line data with 'close' and 'volume' fields

        Returns:
            Result dictionary with OBV value
        """
        n = len(klines)

        if n < 2:
            raise InsufficientDataError(
                required=2,
                actual=n,
                message="OBV requires at least 2 data points"
            )

        closes = self._extract_closes(klines)
        volumes = self._extract_volumes(klines)

        obv_value = 0.0
        for i in range(1, n):
            if closes[i] > closes[i - 1]:
                obv_value += volumes[i]
            elif closes[i] < closes[i - 1]:
                obv_value -= volumes[i]

        return self._create_result_dict(
            value=float(obv_value),
            method='obv',
            parameters={},
            metadata={
                'data_points': n,
                'latest_volume': volumes[-1],
                'latest_close': closes[-1],
                'trend': 'bullish' if obv_value > 0 else 'bearish'
            }
        )

    # =========================================================================
    # MFI (Money Flow Index)
    # =========================================================================

    @validate_inputs
    @timing_decorator
    def mfi14(self, klines: List[Dict[str, Any]]) -> Dict[str, Any]:
        """
        Calculate 14-day Money Flow Index.

        MFI = 100 - 100 / (1 + Money Flow Ratio)
        Money Flow Ratio = Positive Money Flow / Negative Money Flow
        Typical Price = (High + Low + Close) / 3
        Money Flow = Typical Price * Volume

        Args:
            klines: K-line data with 'high', 'low', 'close', 'volume' fields

        Returns:
            Result dictionary with MFI value (0-100)
        """
        period = 14
        n = len(klines)

        if n < period + 1:
            raise InsufficientDataError(
                required=period + 1,
                actual=n,
                message=f"MFI requires at least {period + 1} data points"
            )

        window = klines[-(period + 1):]

        positive_flow = 0.0
        negative_flow = 0.0

        for i in range(1, len(window)):
            # Calculate typical price
            typical_price = (
                float(window[i]['high']) +
                float(window[i]['low']) +
                float(window[i]['close'])
            ) / 3.0

            prev_typical = (
                float(window[i - 1]['high']) +
                float(window[i - 1]['low']) +
                float(window[i - 1]['close'])
            ) / 3.0

            # Calculate money flow
            volume = float(window[i].get('volume', 0))
            money_flow = typical_price * volume

            # Accumulate positive/negative flows
            if typical_price > prev_typical:
                positive_flow += money_flow
            elif typical_price < prev_typical:
                negative_flow += money_flow

        # Calculate MFI
        if negative_flow == 0.0:
            mfi_value = 100.0 if positive_flow > 0 else 50.0
        else:
            money_ratio = positive_flow / negative_flow
            mfi_value = 100.0 - (100.0 / (1.0 + money_ratio))

        return self._create_result_dict(
            value=float(mfi_value),
            method='mfi14',
            parameters={'period': 14},
            metadata={
                'data_points': n,
                'overbought': mfi_value > 80,
                'oversold': mfi_value < 20,
                'positive_flow': positive_flow,
                'negative_flow': negative_flow
            }
        )

    # =========================================================================
    # VWAP (Volume Weighted Average Price)
    # =========================================================================

    @validate_inputs
    @timing_decorator
    def vwap(self, klines: List[Dict[str, Any]]) -> Dict[str, Any]:
        """
        Calculate 20-day Volume Weighted Average Price.

        VWAP = sum(Typical Price * Volume) / sum(Volume)
        Typical Price = (High + Low + Close) / 3

        Args:
            klines: K-line data with 'high', 'low', 'close', 'volume' fields

        Returns:
            Result dictionary with VWAP value
        """
        period = 20
        n = len(klines)

        if n < period:
            raise InsufficientDataError(
                required=period,
                actual=n,
                message=f"VWAP requires at least {period} data points"
            )

        window = klines[-period:]

        sum_pv = 0.0
        sum_v = 0.0

        for k in window:
            typical_price = (
                float(k['high']) +
                float(k['low']) +
                float(k['close'])
            ) / 3.0
            volume = float(k.get('volume', 0))
            sum_pv += typical_price * volume
            sum_v += volume

        if sum_v == 0.0:
            raise ValueError("Total volume is zero, cannot calculate VWAP")

        vwap_value = sum_pv / sum_v
        latest_close = float(klines[-1]['close'])

        return self._create_result_dict(
            value=float(vwap_value),
            method='vwap',
            parameters={'period': 20},
            metadata={
                'data_points': n,
                'total_volume': sum_v,
                'latest_close': latest_close,
                'price_position': 'above' if latest_close > vwap_value else 'below'
            }
        )

    # =========================================================================
    # Volume Moving Averages
    # =========================================================================

    @validate_inputs
    @timing_decorator
    def volume_ma5(self, klines: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Calculate 5-day volume moving average."""
        volumes = self._extract_volumes(klines)
        n = len(volumes)

        if n < 5:
            raise InsufficientDataError(
                required=5,
                actual=n,
                message="Volume MA5 requires at least 5 data points"
            )

        ma_value = float(np.mean(volumes[-5:]))

        return self._create_result_dict(
            value=ma_value,
            method='volume_ma5',
            parameters={'period': 5},
            metadata={
                'data_points': n,
                'latest_volume': volumes[-1],
                'volume_ratio': volumes[-1] / ma_value if ma_value > 0 else 0
            }
        )

    @validate_inputs
    @timing_decorator
    def volume_ma10(self, klines: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Calculate 10-day volume moving average."""
        volumes = self._extract_volumes(klines)
        n = len(volumes)

        if n < 10:
            raise InsufficientDataError(
                required=10,
                actual=n,
                message="Volume MA10 requires at least 10 data points"
            )

        ma_value = float(np.mean(volumes[-10:]))

        return self._create_result_dict(
            value=ma_value,
            method='volume_ma10',
            parameters={'period': 10},
            metadata={
                'data_points': n,
                'latest_volume': volumes[-1],
                'volume_ratio': volumes[-1] / ma_value if ma_value > 0 else 0
            }
        )

    # =========================================================================
    # Volume Ratio
    # =========================================================================

    @validate_inputs
    @timing_decorator
    def volume_ratio(self, klines: List[Dict[str, Any]]) -> Dict[str, Any]:
        """
        Calculate volume ratio (latest volume / volume MA5).

        Volume Ratio > 1: Higher than average volume
        Volume Ratio < 1: Lower than average volume

        Args:
            klines: K-line data with 'volume' field

        Returns:
            Result dictionary with volume ratio
        """
        volumes = self._extract_volumes(klines)
        n = len(volumes)

        if n < 5:
            raise InsufficientDataError(
                required=5,
                actual=n,
                message="Volume ratio requires at least 5 data points"
            )

        latest_volume = volumes[-1]
        ma5_value = float(np.mean(volumes[-5:]))

        if ma5_value == 0:
            raise ValueError("Volume MA5 is zero, cannot calculate volume ratio")

        ratio = latest_volume / ma5_value

        return self._create_result_dict(
            value=float(ratio),
            method='volume_ratio',
            parameters={'ma_period': 5},
            metadata={
                'data_points': n,
                'latest_volume': latest_volume,
                'volume_ma5': ma5_value,
                'high_volume': ratio > 1.5,
                'low_volume': ratio < 0.5
            }
        )

    # =========================================================================
    # Turnover Rate
    # =========================================================================

    @validate_inputs
    @timing_decorator
    def turnover_rate(
        self,
        klines: List[Dict[str, Any]],
        total_shares: float = None
    ) -> Dict[str, Any]:
        """
        Calculate turnover rate.

        Turnover Rate = (Volume / Total Shares) * 100%

        Note: If total_shares is not provided, returns volume as a proxy.

        Args:
            klines: K-line data with 'volume' field
            total_shares: Total outstanding shares (optional)

        Returns:
            Result dictionary with turnover rate
        """
        volumes = self._extract_volumes(klines)
        n = len(volumes)

        if n < 1:
            raise InsufficientDataError(
                required=1,
                actual=n,
                message="Turnover rate requires at least 1 data point"
            )

        latest_volume = volumes[-1]

        if total_shares is not None and total_shares > 0:
            turnover = (latest_volume / total_shares) * 100.0
        else:
            # If total shares not provided, return volume as proxy
            turnover = latest_volume

        return self._create_result_dict(
            value=float(turnover),
            method='turnover_rate',
            parameters={'total_shares': total_shares},
            metadata={
                'data_points': n,
                'latest_volume': latest_volume,
                'has_total_shares': total_shares is not None,
                'high_turnover': turnover > 10.0 if total_shares else False
            }
        )
