# ========================================
# Agent 自动化配置
# ========================================

# Agent API 地址（V2 调用 Agent 的地址）
AGENT_API_URL=http://127.0.0.1:3002
AGENT_API_TOKEN=     # 与 agent 侧 WAKE_TOKEN 一致

# 是否启用 Agent 通知
AGENT_NOTIFY_ENABLED=true

# Agent API 超时时间（秒）
AGENT_TIMEOUT=30

# ========================================
# 飞书配置
# ========================================

# 飞书 Webhook URL（必填）
# 在飞书群聊中添加机器人，获取 Webhook 地址
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-url

# 飞书 Bot Token（可选，用于高级功能）
# FEISHU_BOT_TOKEN=

# ========================================
# 自动化任务配置
# ========================================

# 是否启用盘中监控静默时段（午休时段不推送通知）
ENABLE_SILENT_HOURS=true

# 静默时段（小时，如 11.5 表示 11:30）
SILENT_START_HOUR=11.5
SILENT_END_HOUR=13

# 大盘异动通知阈值（涨跌幅超过此值触发通知）
MARKET_ALERT_THRESHOLD=0.03

# 持仓止损阈值（浮亏超过此值触发通知）
STOP_LOSS_THRESHOLD=-0.08

# 持仓止盈阈值（浮盈超过此值触发通知）
TAKE_PROFIT_THRESHOLD=0.20

# 信号质量最低分数（低于此分数的信号不推送）
MIN_SIGNAL_SCORE=0.7

# 每日最多推送信号数量
MAX_DAILY_SIGNALS=5
