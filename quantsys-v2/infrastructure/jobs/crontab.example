# V13策略定时任务配置
# 用于 crontab 调度

# 环境变量配置
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/b24be3a5-35fc-4142-90c2-3a3933172829

# 项目路径
PROJECT_ROOT=/Users/mac/Documents/ai/pi-investment/quantsys-v2

# ============================================================
# V13策略定时任务
# ============================================================

# 1. 每日调仓检查（交易日 14:25 执行）
25 14 * * 1-5 cd $PROJECT_ROOT && /usr/local/bin/python3 infrastructure/jobs/v13_trading_job.py >> live_trading/logs/v13_trading.log 2>&1

# 2. 验证通知任务（交易日 15:30 执行，检查5天前的预测）
30 15 * * 1-5 cd $PROJECT_ROOT && /usr/local/bin/python3 infrastructure/jobs/verification_job.py >> live_trading/logs/verification.log 2>&1

# 3. 风险检查任务（交易日 16:00 执行）
0 16 * * 1-5 cd $PROJECT_ROOT && /usr/local/bin/python3 infrastructure/jobs/risk_check_job.py >> live_trading/logs/risk_check.log 2>&1

# 4. 周报任务（每周一 09:00 执行）
0 9 * * 1 cd $PROJECT_ROOT && /usr/local/bin/python3 infrastructure/jobs/weekly_report_job.py >> live_trading/logs/weekly_report.log 2>&1

# ============================================================
# 说明
# ============================================================
# - 所有任务仅在交易日执行（周一到周五）
# - 日志文件保存在 live_trading/logs/ 目录
# - 确保 FEISHU_WEBHOOK_URL 环境变量已设置
# - Python路径可能需要根据实际环境调整

# ============================================================
# 安装方法
# ============================================================
# 1. 编辑当前用户的 crontab:
#    crontab -e
#
# 2. 将本文件内容复制进去（去掉注释行或保留）
#
# 3. 保存退出
#
# 4. 查看已安装的定时任务:
#    crontab -l
#
# 5. 查看日志:
#    tail -f live_trading/logs/v13_trading.log
#    tail -f live_trading/logs/verification.log
#    tail -f live_trading/logs/risk_check.log
#    tail -f live_trading/logs/weekly_report.log
