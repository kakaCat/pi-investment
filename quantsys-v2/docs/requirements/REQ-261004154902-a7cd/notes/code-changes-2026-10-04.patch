+
+    def test_expiry_unknown_when_calendar_unavailable(self, repo, calendar, _record_failures):
+        """交易日历取不到 → 判定不了就**不动它**，但必须留痕外发（不许假装没超期）。"""
+        svc = _make_service(repo, calendar, datetime(2026, 10, 6, 9, 31))
