# 开发环境配置

# API 基础地址
VITE_API_BASE_URL=http://localhost:5001

# WebSocket 地址（当前 REST API 服务未启用 Socket.IO，留空避免握手 404）
VITE_WS_URL=

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 是否生成 source map
VITE_BUILD_SOURCEMAP=true

# 应用标题
VITE_APP_TITLE=量化交易系统

# 环境标识
VITE_ENV=development

# 是否启用性能监控
VITE_ENABLE_PERFORMANCE_MONITOR=true

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# 是否启用日志
VITE_ENABLE_LOG=true
