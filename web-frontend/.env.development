# 开发环境配置

# API 基础地址（quantsys-v2 Flask 后端）
VITE_API_BASE_URL=http://127.0.0.1:5001

# WebSocket 地址（quantsys-v2 WebSocket 服务）
VITE_WS_URL=ws://127.0.0.1:5003

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 是否生成 source map
VITE_BUILD_SOURCEMAP=true

# 应用标题
VITE_APP_TITLE=量化交易系统

# 环境标识
VITE_ENV=development

# 是否启用性能监控
VITE_ENABLE_PERFORMANCE_MONITOR=true

# API 请求超时时间（毫秒）
VITE_API_TIMEOUT=30000

# 是否启用日志
VITE_ENABLE_LOG=true
