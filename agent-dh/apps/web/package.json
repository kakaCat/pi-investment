{
  "name": "@pi-investment/agent-dh-web-frontend",
  "description": "Web application entry: vite build over the @deepseek-ai/dsh-client-web shell library; served by agent-dh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "start": "node --import tsx/esm src/main.ts",
    "start:dev": "node --import tsx/esm src/main.ts --verbose",
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "watch": "vite build --watch --no-emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/cosmokit": "1.8.3",
    "@deepseek-ai/dsh": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-base": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-modules": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-web": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-shell": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-skill": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-util-crypto": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-web-app": "0.1.6-alpha.2",
    "@shikijs/langs": "^4.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "immer": "^10.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0",
    "yaml": "^2.3.4",
    "zod": "4.6.2",
    "zustand": "~4.4.7"
  },
  "devDependencies": {
    "@pi-investment/agent-dh-client": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vitest": "^1.2.0",
    "tsx": "^4.23.12"
  }
}
