{
  "name": "@pi-investment/agent-dh",
  "version": "0.1.1",
  "private": true,
  "description": "Agent-DH: Distributed Hierarchical Agent System for PI Investment",
  "type": "module",
  "workspaces": [
    "packages/*",
    "profiles/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:clients": "pnpm --filter @pi-investment/agent-os-client build && pnpm --filter @pi-investment/quantsys-v2-client build",
    "postinstall": "pnpm build:clients",
    "test": "pnpm -r test && vitest run tests/",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
