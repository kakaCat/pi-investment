{
  "name": "@pi-investment/lifecycle",
  "version": "0.1.0",
  "description": "lifecycle plugin for Agent-DH: self-restart with git safety net",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/restarter/restarter.ts --dts",
    "dev": "tsdown src/index.ts src/restarter/restarter.ts --dts --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@pi-investment/quantsys-v2-client": "workspace:*",
    "@pi-investment/agent-os-client": "workspace:*",
    "@pi-investment/core-tool": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "tsdown": "^0.22.14"
  }
}