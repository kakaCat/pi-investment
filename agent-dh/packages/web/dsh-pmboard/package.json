{
  "name": "dsh-pmboard",
  "version": "0.1.0",
  "description": "项目看板 dsh-pmboard — DSH 需求流水线页面插件（host: reqboard JSON+SSE API 与 13 个立项/拆分/验收工具；client: GUI 看板视图）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": "./lib/client.js"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakaCat/pi-investment.git",
    "directory": "agent-dh/packages/web/dsh-pmboard"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.mjs && pnpm build:client",
    "build:client": "tsdown -c tsdown.client.config.mjs && node scripts/wrap-client.mjs && node scripts/verify-client-build.mjs",
    "verify:client": "node scripts/verify-client-build.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^20.11.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "sessions",
        "workspaces"
      ]
    }
  }
}
