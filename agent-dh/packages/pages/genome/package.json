{
  "name": "@pi-investment/dashboard-genome",
  "version": "0.1.0",
  "description": "自主进化看板 @pi-investment/dashboard-genome — DSH GUI 双半插件（host: genome JSON API；client: GUI 侧栏入口 + 中心栏视图）。Autonomy 线能力设计层可观测：基因组段状态/候选生命周期/gate 谱系/状态一致性诊断（C1-C3，F1 哨兵可视化仪表）",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./client": "./lib/client.js"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build:client": "node ../../../node_modules/tsdown/dist/run.mjs -c tsdown.client.config.ts && node scripts/wrap-client.mjs"
  },
  "dependencies": {
    "@pi-investment/page-kit": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}