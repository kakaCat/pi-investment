{
  "name": "@pi-investment/reqboard",
  "version": "0.1.0",
  "description": "Requirements board RTM (Requirements Traceability Matrix) utilities",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./rtm/*": {
      "import": "./src/rtm/*.ts",
      "types": "./src/rtm/*.ts"
    },
    "./types/*": {
      "import": "./src/types/*.ts",
      "types": "./src/types/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.3"
  }
}
