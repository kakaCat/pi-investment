@@ -1033,6 +1033,14 @@ call: (method, args = null) => env.invoke(method, args) }, harnessTrap(), ...Obj
 					this.syncChain = this.syncChain.then(async () => {
 						await this.host.sync(manifests);
 					}).catch((error) => {
+						// @pi-investment patch: 传输层失败（服务重启/断网导致 fetch 根本发不出去）
+						// 不是业务错误——重连后 connection/reset 会触发 publish() 补发清单。
+						// 降级为 warn，避免每次服务重启都在 console 里留一条吓人的红错。
+						const message = error instanceof Error ? error.message : String(error);
+						if (/Failed to fetch|fetch failed|ECONNREFUSED|ERR_CONNECTION|NetworkError|carrier (offline|down)|transport (down|offline)/i.test(message)) {
+							console.warn("[cordis-client-runner] inspect manifest sync deferred: transport down (will re-publish on reconnect)");
+							return;
+						}
 						console.error("[cordis-client-runner] syncing inspect providers failed:", error);
 					});
 				});
