{
  "name": "pi-investment",
  "version": "0.1.0",
  "type": "module",
  "description": "AI 股票投资顾问 - 基于 piagent 架构",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:log": "tsx src/index-with-logger.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "portfolio": "tsx src/scripts/portfolio-cli.ts",
"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.38.0",
    "@mariozechner/pi-agent-core": "^0.58.3",
    "@mariozechner/pi-ai": "^0.58.3",
    "@mariozechner/pi-coding-agent": "^0.58.3",
    "@mariozechner/pi-tui": "^0.58.3",
    "@sinclair/typebox": "^0.34.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "openai": "^4.77.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
